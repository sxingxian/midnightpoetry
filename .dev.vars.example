# Copy to .env.local for `next dev` (and to .dev.vars for `npm run preview`).
# Public values are baked into the build; set them as GitHub Actions *variables* too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only secrets. In production set them with `npx wrangler secret put NAME`.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Midnight Poetry Studio <security@sxingxian.com>"
OWNER_NOTIFY_EMAIL=you@example.com
# Any long random string (openssl rand -hex 32). Also run once in Supabase SQL:
#   select public.set_click_secret('the same value');
AD_CLICK_SECRET=
